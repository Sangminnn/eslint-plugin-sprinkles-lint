{
  "name": "eslint-plugin-sprinkles-lint",
  "version": "2.16.0",
  "description": "ESLint plugin for vanilla-extract sprinkles (supports both legacy and flat config)",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "eslint.config.js"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "node src/tests/comprehensive.test.js && node src/tests/flex-conversion.test.js && node src/tests/autofix-safety.test.js",
    "test:basic": "node src/tests/sprinkles-rules.test.js",
    "test:flex": "node src/tests/flex-conversion.test.js",
    "test:autofix": "node src/tests/autofix-safety.test.js",
    "test:transform": "node src/tests/transformation.test.js",
    "test:live": "node src/tests/live-transformation.test.js"
  },
  "keywords": [
    "eslint",
    "plugin",
    "vanilla-extract",
    "sprinkles",
    "lint",
    "flat-config",
    "eslint-config"
  ],
  "author": "Sangminnn <psm0102psm@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "eslint": "^8.0.0"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sangminnn/eslint-plugin-sprinkles-lint.git"
  }
}
